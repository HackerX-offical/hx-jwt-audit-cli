{
  "name": "hx-jwt-audit-cli",
  "version": "1.0.0",
  "description": "Advanced JWT/JWS security audit — algorithm confusion, JWK abuse, claim policy, verification oracles",
  "type": "module",
  "bin": {
    "hx-jwt": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "jwt",
    "jws",
    "security",
    "oauth",
    "cli",
    "hackerx"
